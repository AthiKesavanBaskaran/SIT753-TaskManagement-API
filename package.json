{
  "name": "taskmanagement-api",
  "version": "1.0.0",
  "description": "Simple Task Management API for CI/CD Pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "jest-junit": "^17.0.0",
    "supertest": "^6.3.3"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
